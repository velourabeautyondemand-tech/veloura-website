
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isAdmin();
    }

    match /blogPosts/{slug} {
      allow get, list: if true;
      allow write: if true; 
    }

    match /services/{serviceId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
        allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.technicianId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (request.query.limit <= 50);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.technicianId == request.auth.uid || isAdmin());
        allow delete: if isAdmin();
    }

    match /webhook_logs/{logId} {
        allow read: if isAdmin();
        allow write: if true; 
    }

    match /technician_applications/{applicationId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /technicians/{technicianId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /subscribers/{subscriberId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if true;
        allow update: if false;
        allow delete: if false;
    }

    match /contact_inquiries/{inquiryId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if true;
        allow update: if false;
        allow delete: if isAdmin();
    }

    match /press_inquiries/{inquiryId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if true;
        allow update: if false;
        allow delete: if isAdmin();
    }

    match /partnership_inquiries/{inquiryId} {
        allow get: if isAdmin();
        allow list: if isAdmin();
        allow create: if true;
        allow update: if false;
        allow delete: if isAdmin();
    }

    match /product_inquiries/{inquiryId} {
        allow get, list: if isAdmin();
        allow create: if true;
        allow update, delete: if isAdmin();
    }
  }
}

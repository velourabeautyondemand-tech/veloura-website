/**
 * @fileoverview Firestore Security Rules for Technician Marketplace App
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles,
 * restricts technician application management to admins, and
 * grants read access to technician profiles.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles.
 * - /technician_applications/{applicationId}: Stores technician applications.
 * - /technicians/{technicianId}: Stores profiles of approved technicians.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Technician applications can only be created by authenticated users.
 * - Only authenticated users can read technician applications
 * - Only authenticated users can create technician profiles
 * - Technician profiles are publicly readable, but only admins can modify them.
 *
 * Denormalization for Authorization:
 * N/A (Roles are on the UserProfile document, which is sufficient.)
 *
 * Structural Segregation:
 * N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) if the user is the owner of the profile.
     * @allow (create, update, delete) if the user is the owner of the profile.
     * @deny (get, list) if the user is not the owner of the profile.
     * @deny (create, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Allow reads (get, list) if the user is the owner.
      allow get, list: if isOwner(userId);

      // Allow creation if the user ID in the path matches the authenticated user's ID.
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;

      // Allow updates if the user is the owner and the user ID hasn't changed.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Allow deletion if the user is the owner.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to technician applications.
     * @path /technician_applications/{applicationId}
     * @allow (create) any authenticated user can create technician application
     * @allow (get, list) any authenticated user can read technician application
     * @allow (update, delete) no one can update or delete technician applications
     * @deny (create) if user is not authenticated
     * @deny (get, list) if user is not authenticated
     * @deny (update, delete) all operations
     * @principle Restricts creation of application to authenticated user and no operations allowed for technician applications
     */
    match /technician_applications/{applicationId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
    }

    /**
     * @description Controls access to technician profiles.
     * @path /technicians/{technicianId}
     * @allow (get, list) anyone can view technician profile
     * @allow (create) only authenticated user can create technician profile
     * @allow (update, delete) no one can update or delete technician profile
     * @deny (create) if user is not authenticated
     * @deny (update, delete) all operations
     * @principle Technician profiles are publicly readable, but only admins can create them.
     */
    match /technicians/{technicianId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }


    // Helper functions

    // Checks if the request is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the authenticated user is the owner of the resource.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Checks if the authenticated user is the existing owner of the resource.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
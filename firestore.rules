/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict ownership and role-based access control.
 * It assumes a data model where users own their profiles and administrators manage technician applications.
 * Data validation is relaxed to allow rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile data. Access is restricted to the owner (the user themselves).
 * - /technician_applications/{applicationId}: Stores technician applications. Only administrators can create, update, or delete applications.
 * - /technicians/{technicianId}: Stores profiles of approved technicians.  Access is restricted to administrators.
 *
 * Key Security Decisions:
 * - User profiles are strictly owned; users can only read/write their own profile data.
 * - Technician applications can only be managed by admins.
 * - No user listing is allowed to prevent data scraping.
 *
 * Denormalization for Authorization:
 * - No denormalization is required as user IDs are available in the auth token,
 *   and admin status is checked using a simple function.
 *
 * Structural Segregation:
 * - The data is structurally segregated into different collections based on access control requirements.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' creates their own profile.
     *   auth.uid: 'user123'
     *   request.resource.data: { id: 'user123', email: 'test@example.com', role: 'customer' }
     * @allow (get, update, delete) - User with ID 'user123' reads/updates/deletes their own profile.
     *   auth.uid: 'user123'
     * @deny (create) - User with ID 'user123' attempts to create a profile for 'user456'.
     *   auth.uid: 'user123'
     *   request.resource.data: { id: 'user456', email: 'test@example.com', role: 'customer' }
     * @deny (get, update, delete) - User with ID 'user123' attempts to read/update/delete the profile of 'user456'.
     *   auth.uid: 'user123'
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Users can only read their own profile.
      allow get: if isOwner(userId);
      // Users can only list their own data
      allow list: if isOwner(userId);

      // Users can create their own profile if the userId matches their auth.uid.
      allow create: if isOwner(userId) && request.resource.data.id == userId;

      // Users can update their own profile. Enforce immutability of userId.
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;

      // Users can delete their own profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows administrators to manage technician applications.
     * @path /technician_applications/{applicationId}
     * @allow (create) - Admin user creates a new technician application.
     *   auth.uid: 'admin123' (assuming 'admin123' is an admin)
     * @allow (get, list, update, delete) - Admin user reads/lists/updates/deletes any technician application.
     *   auth.uid: 'admin123' (assuming 'admin123' is an admin)
     * @deny (create, update, delete) - Non-admin user attempts to create/update/delete a technician application.
     *   auth.uid: 'user123' (assuming 'user123' is NOT an admin)
     * @principle Restricts access to technician applications to administrators.
     */
    match /technician_applications/{applicationId} {
      // Admins can read technician applications.
      allow get: if isAdmin();
      // Admins can list technician applications.
      allow list: if isAdmin();

      // Admins can create technician applications.
      allow create: if isAdmin();

      // Admins can update technician applications.
      allow update: if isAdmin() && resource != null;

      // Admins can delete technician applications.
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows administrators to manage technician profiles.
     * @path /technicians/{technicianId}
     * @allow (create) - Admin user creates a new technician profile.
     *   auth.uid: 'admin123' (assuming 'admin123' is an admin)
     * @allow (get, list, update, delete) - Admin user reads/lists/updates/deletes any technician profile.
     *   auth.uid: 'admin123' (assuming 'admin123' is an admin)
     * @deny (create, update, delete) - Non-admin user attempts to create/update/delete a technician profile.
     *   auth.uid: 'user123' (assuming 'user123' is NOT an admin)
     * @principle Restricts access to technician profiles to administrators.
     */
    match /technicians/{technicianId} {
      // Admins can read technician profiles.
      allow get: if isAdmin();
      // Admins can list technician profiles.
      allow list: if isAdmin();

      // Admins can create technician profiles.
      allow create: if isAdmin();

      // Admins can update technician profiles.
      allow update: if isAdmin() && resource != null;

      // Admins can delete technician profiles.
      allow delete: if isAdmin() && resource != null;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the document.
  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  // Helper function to determine if the user is the owner of the document and if the document exists.
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

  // Helper function to determine if the user is an admin.
  // NOTE: This is a placeholder.  In a real application, you would
  // implement a more robust mechanism for determining admin status,
  // such as checking a custom claim on the user's JWT or querying a
  // database of admin users.
  function isAdmin() {
    return isSignedIn() && request.auth.token.email == 'admin@example.com'; // Replace with your admin check logic
  }
}
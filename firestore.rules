/**
 * @description This ruleset enforces a role-based access control model with a focus on user-owned data and public technician application submissions.
 * @dataStructure
 *   - `/technician_applications/{applicationId}`: Stores technician applications.
 *   - `/technicians/{technicianId}`: Stores approved technician profiles.
 *   - `/users/{userId}/jobs/{jobId}`: Stores job details for each technician, nested under their user ID.
 *   - `/roles_admin/{uid}`: Indicates admin role assignment; document existence implies admin status.
 * @keySecurityDecisions
 *   - Technician applications are publicly writable, but other collections are restricted to authorized users.
 *   - Listing of `/users/{userId}/jobs/{jobId}` is only allowed by the owner (`userId`).
 *   - Admin status is determined by the existence of a document in the `/roles_admin/{uid}` collection.
 * @denormalizationForAuthorization
 *   - Admin status is checked directly via document existence in `/roles_admin/{uid}`, avoiding external `get()` calls.
 * @structuralSegregation
 *   - The separation of `technician_applications` and `technicians` collections allows for different access controls: public submissions vs. restricted access to approved profiles.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create technician applications, but restricts other operations.
     * @path /technician_applications/{applicationId}
     * @allow (create) - Any user can submit a technician application.
     *   - Request: `auth: null`, `method: create`, `path: /databases/(default)/documents/technician_applications/newApplication`
     *   - Request Data: `{firstName: "John", lastName: "Doe", ...}`
     * @deny (get, list, update, delete) - Only creation is allowed.
     *   - Request: `auth: {uid: 'someUser'}`, `method: get`, `path: /databases/(default)/documents/technician_applications/someApplication`
     * @principle Allows public creation of technician applications.
     */
    match /technician_applications/{applicationId} {
      allow get, list: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    /**
     * @description Allows admins to manage technician profiles.
     * @path /technicians/{technicianId}
     * @allow (get, list, create, update, delete) - Admins can perform all operations on technician profiles.
     *   - Request: `auth: {uid: 'adminUser'}`, `method: create`, `path: /databases/(default)/documents/technicians/newTechnician`
     * @deny (get, list, create, update, delete) - Non-admins cannot manage technician profiles.
     *   - Request: `auth: {uid: 'regularUser'}`, `method: create`, `path: /databases/(default)/documents/technicians/newTechnician`
     * @principle Restricts technician profile management to admins.
     */
    match /technicians/{technicianId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    /**
     * @description Allows a user to manage their own jobs.
     * @path /users/{userId}/jobs/{jobId}
     * @allow (get, list, create, update, delete) - The owner (identified by userId) can perform all operations on their jobs.
     *   - Request: `auth: {uid: 'user123'}`, `method: create`, `path: /databases/(default)/documents/users/user123/jobs/newJob`
     * @deny (get, list, create, update, delete) - Other users cannot access or modify these job documents.
     *   - Request: `auth: {uid: 'otherUser'}`, `method: create`, `path: /databases/(default)/documents/users/user123/jobs/newJob`
     * @principle Enforces user-ownership for job management.
     */
    match /users/{userId}/jobs/{jobId} {
      allow get, create, update, delete, list: if isOwner(userId);
    }

    /**
     * @description Determines admin status based on document existence in this collection.
     * @path /roles_admin/{uid}
     * @allow (get, list) - Anyone can check if a user is an admin (useful for UI).
     *   - Request: `auth: {uid: 'anyUser'}`, `method: get`, `path: /databases/(default)/documents/roles_admin/adminUser`
     * @allow (create) - Only the user themselves can create the document to assign the admin role.
     *   - Request: `auth: {uid: 'adminUser'}`, `method: create`, `path: /databases/(default)/documents/roles_admin/adminUser`
     * @deny (update, delete) - Admin role cannot be updated or deleted without proper authorization.
     *   - Request: `auth: {uid: 'anyUser'}`, `method: delete`, `path: /databases/(default)/documents/roles_admin/adminUser`
     * @principle Role management based on document existence.
     */
    match /roles_admin/{uid} {
      allow get, list: if true; // Publicly readable to determine admin status
      allow create: if request.auth.uid == uid;
      allow update, delete: if false;
    }


    // ---- Helper Functions ----

    /**
     * @description Checks if the current user is signed in.
     * @returns {boolean} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is an admin by verifying the existence of a document in /roles_admin/{uid}.
     * @returns {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

  }
}
/**
 * @file Firebase Security Rules for the Nail Tech Platform
 *
 * @core_philosophy This ruleset enforces a user-ownership model for user profiles
 *   and restricts access to other data based on user roles and relationships.
 *   It prioritizes secure authorization with flexible data shapes for prototyping.
 * @data_structure
 *   - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 *   - /technicians/{technicianId}: Stores technician profiles, accessible only to admins.
 *   - /customers/{customerId}: Stores customer profiles, accessible only to admins.
 *   - /services/{serviceId}: Stores service information, managed by admins.
 *   - /bookings/{bookingId}: Stores booking information. Accessible by admins, the relevant customer, and technician.
 * @key_security_decisions
 *   - User listing is disabled to prevent unauthorized data scraping.
 *   - Data validation is limited to ownership and relational integrity checks
 *     to allow for rapid prototyping and schema evolution.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data, ensuring users can only access their own profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile at /users/user123.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, and delete their profile at /users/user123.
     * @deny (create, get, update, delete) - User with UID 'user456' cannot access profile data at /users/user123.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      // Verified authentication
      function isSignedIn() {
        return request.auth != null;
      }

      // Authenticated user is the owner
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Authenticated user is the owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages technician profiles. Only admins can access and manage these profiles.
     * @path /technicians/{technicianId}
     * @allow (create) - An admin can create a technician profile at /technicians/tech123.
     * @allow (get, update, delete) - An admin can read, update, and delete a technician profile at /technicians/tech123.
     * @deny (create, get, update, delete) - A non-admin user cannot access technician profile data.
     * @principle Restricts technician profile management to authorized personnel (admins).
     */
    match /technicians/{technicianId} {
      // Anyone can read the technician profile
      allow get: if true;
      // Anyone can list the technician profile
      allow list: if true;
      allow create: if false;  // TODO: Add admin check once roles are implemented.
      allow update: if false; // TODO: Add admin check once roles are implemented.
      allow delete: if false; // TODO: Add admin check once roles are implemented.
    }

        /**
     * @description Manages customer profiles. Only admins can access and manage these profiles.
     * @path /customers/{customerId}
     * @allow (create) - An admin can create a customer profile at /customers/customer123.
     * @allow (get, update, delete) - An admin can read, update, and delete a customer profile at /customers/customer123.
     * @deny (create, get, update, delete) - A non-admin user cannot access customer profile data.
     * @principle Restricts customer profile management to authorized personnel (admins).
     */
    match /customers/{customerId} {
      // Anyone can read the customer profile
      allow get: if true;
      // Anyone can list the customer profile
      allow list: if true;
      allow create: if false; // TODO: Add admin check once roles are implemented.
      allow update: if false; // TODO: Add admin check once roles are implemented.
      allow delete: if false; // TODO: Add admin check once roles are implemented.
    }

    /**
     * @description Manages service definitions. Only admins can create, update, and delete services.
     * @path /services/{serviceId}
     * @allow (create) - An admin can create a service at /services/service123.
     * @allow (get, update, delete) - An admin can read, update, and delete a service at /services/service123.
     * @deny (create, get, update, delete) - A non-admin user cannot manage services.
     * @principle Ensures only authorized personnel can modify service offerings.
     */
    match /services/{serviceId} {
      // Anyone can read the service
      allow get: if true;
      // Anyone can list the service
      allow list: if true;
      allow create: if false; // TODO: Add admin check once roles are implemented.
      allow update: if false; // TODO: Add admin check once roles are implemented.
      allow delete: if false; // TODO: Add admin check once roles are implemented.
    }

    /**
     * @description Manages bookings. Accessible by admins, and the relevant customer and technician.
     * @path /bookings/{bookingId}
     * @allow (create) - An admin, customer, or technician can create a booking.
     * @allow (get, update, delete) - An admin, the customer who made the booking, or the assigned technician can access and manage the booking.
     * @deny (create, get, update, delete) - A user who is not an admin, the booking's customer, or the booking's technician cannot access or modify the booking.
     */
    match /bookings/{bookingId} {
      // Anyone can read the booking
      allow get: if true;
      // Anyone can list the booking
      allow list: if true;
      allow create: if false; // TODO: Add customer/tech check once roles are implemented.
      allow update: if false; // TODO: Add customer/tech check once roles are implemented.
      allow delete: if false; // TODO: Add customer/tech check once roles are implemented.
    }
  }
}
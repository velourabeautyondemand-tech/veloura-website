/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with user-owned profiles and public technician directories.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles. Access is restricted to the owner.
 * - /technician_applications/{applicationId}: Stores technician applications. Only authenticated users can submit.
 * - /technicians/{technicianId}: Stores approved technician profiles. Public read, admin-only write.
 * - /press_inquiries/{pressInquiryId}: Stores press inquiries. Public create.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owner.
 * - Technician applications can be created by any signed-in user.
 * - The technician profiles collection has public read access but restricted write access (admin only).
 * - Press Inquiries collection has public write access (for prototyping).
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data != null;
    }

    /**
     * @description Allows the user to read technician application.
     */
    function canReadTechnicianApplication(applicationId) {
       return false;
    }

    /**
     * @description Allows the user to write technician application.
     */
    function canWriteTechnicianApplication(applicationId) {
       return false;
    }


    /**
     * @description Defines the access rules for user profiles.
     * @path /users/{userId}
     * @allow (get, list) User with ID 'user123' can read their own profile.
     * @allow (create, update, delete) User with ID 'user123' can create, update, or delete their own profile.
     * @deny (get, list) User with ID 'user456' cannot read the profile of user with ID 'user123'.
     * @deny (create, update, delete) User with ID 'user456' cannot create, update, or delete the profile of user with ID 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isOwner(userId);
      allow delete: if isSignedIn() && request.auth.uid == userId && isOwner(userId);
    }

    /**
     * @description Defines the access rules for technician applications.
     * @path /technician_applications/{applicationId}
     * @allow (create) Any authenticated user can create a technician application.
     * @deny (get, list, update, delete) Only admins can read, list, update or delete applications.
     * @principle Restricts access to technician applications to authorized users.
     */
    match /technician_applications/{applicationId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Defines the access rules for approved technicians.
     * @path /technicians/{technicianId}
     * @allow (get, list) Anyone can read the list of technicians.
     * @deny (create, update, delete) Only admins can create, update, or delete technician profiles.
     * @principle Enforces read-only access for the public and restricts write access to admins.
     */
    match /technicians/{technicianId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Defines the access rules for press inquiries.
      * @path /press_inquiries/{pressInquiryId}
      * @allow (create) Anyone can submit a press inquiry.
      * @deny (get, list, update, delete) Only admins can read, list, update or delete inquiries.
      */
    match /press_inquiries/{pressInquiryId} {
        allow get: if false;
        allow list: if false;
        allow create: if true;
        allow update: if false;
        allow delete: if false;
      }
  }
}
/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict user-based authorization.
 * It is configured for rapid prototyping, which means it focuses on access control
 * and less on comprehensive data validation. Data validation should be implemented
 * in the application code during prototyping.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores public user profile information.  Access is restricted to the owning user.
 * - `/technician_applications/{applicationId}`: Stores technician applications. Only admins can manage applications.
 * - `/technicians/{technicianId}`: Stores technician profiles. Only admins can manage technician profiles.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data under `/users/{userId}`.
 * - Technician applications and profiles can only be managed by authenticated admins.
 * - List operations on `/technician_applications` and `/technicians` are forbidden to regular users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (get, list) if the user is the owner of the profile.
     * @allow (create, update, delete) if the user is the owner of the profile and the request is valid.
     * @deny (get, list) if the user is not the owner of the profile.
     * @deny (create, update, delete) if the user is not the owner of the profile.
     * @principle Enforces document ownership and prevents unauthorized modification of user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to technician applications.
     * @path /technician_applications/{applicationId}
     * @allow (create) if the user is signed in.
     * @allow (get, list, update, delete) if the user is an admin.
     * @deny (get, list, update, delete) if the user is not an admin.
     * @principle Restricts management of technician applications to admins.
     */
    match /technician_applications/{applicationId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to technician profiles.
     * @path /technicians/{technicianId}
     * @allow (get, list) if the user is an admin.
     * @allow (create, update, delete) if the user is an admin.
     * @deny (get, list) if the user is not an admin.
     * @deny (create, update, delete) if the user is not an admin.
     * @principle Restricts management of technician profiles to admins.
     */
    match /technicians/{technicianId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param userId The user ID to check against.
     * @return True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param userId The user ID to check against.
     * @return True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has the admin role.
     * @return True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
  }
}
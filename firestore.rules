/**
 * @description This ruleset enforces a role-based access control model with a separate technicians and technician_application collections. Unauthenticated users can submit technician applications, while only authenticated admins can approve them, moving approved profiles to the `technicians` collection. Each technician has a separate user id for nested jobs.
 * @dataStructure
 * - /technician_applications/{applicationId}: Stores application data; publicly creatable, restricted updates.
 * - /technicians/{technicianId}: Stores approved technician profiles; restricted create, update, and delete access.
 * - /users/{userId}/jobs/{jobId}: Stores job details for each technician, nested under their user ID.
 * - /roles_admin/{uid}: Admin role assignments; document existence grants admin privileges.
 * @keySecurityDecisions
 * - Unauthenticated users can create technician applications.
 * - Only authenticated admins can approve applications and create technician profiles.
 * - All write operations on /technicians collection require admin privileges.
 * - The ability to list the `/technicians` collection is publicly available to support browsing.
 * - Strict ownership is enforced for data under `/users/{userId}`.
 * @denormalizationForAuthorization
 * - The `roles_admin` collection is used to quickly determine if a user is an admin, avoiding complex role lookups. The existance of a document with their `uid` as the document id in the `roles_admin` collection implies the user is an admin.
 * @structuralSegregation
 * - Separate collections are used for technician applications (open to all) and approved technician profiles (admin-only), ensuring that only approved technicians are publicly visible.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create technician applications, but restricts updates and deletes.
     * @path /technician_applications/{applicationId}
     * @allow (create) - An unauthenticated user can create a technician application.
     * @deny (update, delete) - No one can update or delete a technician application after creation.
     * @principle Allows unauthenticated users to submit technician applications while preventing unauthorized modifications.
     */
    match /technician_applications/{applicationId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts create, update, and delete operations on technician profiles to admins only. Allows public read access.
     * @path /technicians/{technicianId}
     * @allow (create, update, delete) - An admin can create, update, or delete a technician profile.
     * @deny (create, update, delete) - A non-admin user cannot create, update, or delete a technician profile.
     * @principle Enforces strict admin control over technician profiles while allowing public visibility.
     */
    match /technicians/{technicianId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Restricts access to job documents to the owner (technician) only.
     * @path /users/{userId}/jobs/{jobId}
     * @allow (create, get, list, update, delete) - The owner (technician) can create, get, list, update, and delete their own job documents.
     * @deny (create, get, list, update, delete) - A non-owner cannot access or modify another technician's job documents.
     * @principle Enforces strict ownership for job documents, ensuring technicians can only manage their own jobs.
     */
    match /users/{userId}/jobs/{jobId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Grants admin privileges to users with a document in this collection, identified by their UID.
     * @path /roles_admin/{uid}
     * @allow (get, create, update, delete) - Only an admin can manage admin roles.
     * @deny (get, create, update, delete) - A non-admin user cannot grant themselves admin privileges.
     * @principle Uses document existence to define admin roles, simplifying role-based access control.
     */
    match /roles_admin/{uid} {
      allow get: if isAdmin();
      allow list: if isAdmin(); // Listing admins is likely an admin function.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
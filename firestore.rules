/**
 * @fileOverview Firestore Security Rules for the Technician Booking Application.
 *
 * Core Philosophy:
 * This ruleset implements a role-based access control model with user-specific data trees.
 * Technician applications are open for submission, while technician profiles are restricted to admin approval.
 * Each technician (identified by their UID) owns their job data.  Admins are managed through a dedicated collection.
 *
 * Data Structure:
 * - /technician_applications/{applicationId}: Stores application data, publicly writable.
 * - /technicians/{technicianId}: Stores approved technician profiles, only writable by admins.
 * - /users/{userId}/jobs/{jobId}: Stores job data for technicians, only accessible by the owning technician.
 * - /roles_admin/{uid}:  Marks a user as an admin; the document's existence confers admin rights.
 *
 * Key Security Decisions:
 * - Technician applications are publicly writable to allow open submissions.
 * - Listing technician applications is open.
 * - Technician profiles are managed by admins; regular users cannot create, update, or delete them.
 * - Each technician can only access their own job data.
 * - Only admins can manage technician profiles.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create technician applications.
     * @path /technician_applications/{applicationId}
     * @allow (create) - Any user can create a technician application.
     * @deny (update) - No one can update a technician application.
     * @principle Allows open application submissions.
     */
    match /technician_applications/{applicationId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    /**
     * @description Allows admins to manage technician profiles.
     * @path /technicians/{technicianId}
     * @allow (create) - An admin can create a technician profile.
     * @deny (update) - A non-admin cannot update a technician profile.
     * @principle Restricts technician profile management to admins.
     */
    match /technicians/{technicianId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Allows a technician to manage their own jobs.
     * @path /users/{userId}/jobs/{jobId}
     * @allow (create) - A technician can create a job under their user ID.
     * @deny (update) - A technician cannot update another technician's job.
     * @principle Enforces document ownership for job data.
     */
    match /users/{userId}/jobs/{jobId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read roles, only admins can create/update
     * @path /roles_admin/{uid}
     * @allow (get) - Any user can read admin roles.
     * @deny (create) - A non-admin cannot assign admin roles.
     * @principle Restricts admin role management to existing admins.
     */
    match /roles_admin/{uid} {
        allow get, list: if true;
        allow create: if isAdmin();
        allow update: if isAdmin() && resource != null;
        allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Checks if the current user is authenticated.
     * @returns {boolean} True if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the user ID matches the request's authentication UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the user ID matches the request's authentication UID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the current user has admin privileges.
     * @returns {boolean} True if the user has admin privileges.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with owner-only restrictions for user profiles.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /technicians/{technicianId}: Stores technician profile information, accessible only to admins (currently disabled, see TODO).
 * - /customers/{customerId}: Stores customer profile information, accessible only to admins (currently disabled, see TODO).
 * - /services/{serviceId}: Stores information about the services offered, accessible only to admins (currently disabled, see TODO).
 * - /bookings/{bookingId}: Stores booking information, accessible only to admins, and the relevant customer and technician (currently disabled, see TODO).
 *
 * Key Security Decisions:
 * - User listing is disallowed for all collections.
 * - Admin role enforcement is a placeholder; proper admin role implementation is required.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 *   - User profiles are stored under /users/{userId}, ensuring that `request.auth.uid` always matches `userId`.
 *
 * Structural Segregation:
 *   - There is no deliberate segregation between public and private data. All data is treated as private unless explicitly opened.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces owner-only access to user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile at /users/user123.
     * @deny (create) - User with UID 'user123' cannot create a profile at /users/otherUser.
     * @allow (get, update, delete) - User with UID 'user123' can get, update and delete their own profile at /users/user123.
     * @deny (get, update, delete) - User with UID 'user123' cannot get, update, or delete another user's profile at /users/otherUser.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Helper function to check if the authenticated user is the owner of the document.
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the existing document.
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to technician profiles. Currently only allows admins to manage technicians.
     * @path /technicians/{technicianId}
     * @allow (create, get, update, delete) - If isAdmin() returns true.
     * @deny (create, get, update, delete) - If isAdmin() returns false.
     * @principle Restricts access to admins.
     */
    match /technicians/{technicianId} {
      function isAdmin() {
        return false; // TODO: Implement proper admin role check.
      }
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to customer profiles. Currently only allows admins to manage customers.
     * @path /customers/{customerId}
     * @allow (create, get, update, delete) - If isAdmin() returns true.
     * @deny (create, get, update, delete) - If isAdmin() returns false.
     * @principle Restricts access to admins.
     */
    match /customers/{customerId} {
      function isAdmin() {
        return false; // TODO: Implement proper admin role check.
      }
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to service definitions. Currently only allows admins to manage services.
     * @path /services/{serviceId}
     * @allow (create, get, update, delete) - If isAdmin() returns true.
     * @deny (create, get, update, delete) - If isAdmin() returns false.
     * @principle Restricts access to admins.
     */
    match /services/{serviceId} {
      function isAdmin() {
        return false; // TODO: Implement proper admin role check.
      }
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to booking information. Currently only allows admins, the customer, and the technician to manage bookings.
     * @path /bookings/{bookingId}
     * @allow (create, get, update, delete) - If isAdmin() or isCustomerOrTechnician() returns true.
     * @deny (create, get, update, delete) - If isAdmin() or isCustomerOrTechnician() returns false.
     * @principle Restricts access to admins, the customer, and the technician.
     */
    match /bookings/{bookingId} {
      function isAdmin() {
        return false; // TODO: Implement proper admin role check.
      }
      function isCustomerOrTechnician() {
        return false; // TODO: Implement customer/technician role check based on booking data.
      }
      allow get: if isAdmin() || isCustomerOrTechnician();
      allow list: if false;
      allow create: if isAdmin() || isCustomerOrTechnician();
      allow update: if isAdmin() || isCustomerOrTechnician();
      allow delete: if isAdmin() || isCustomerOrTechnician();
    }
  }
}
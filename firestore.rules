/**
 * @description This ruleset enforces a role-based access control model with owner-only access for user-specific data.
 *  It allows unauthenticated users to create technician applications, but restricts modifications and reads.
 *  Approved technicians are stored separately for public browsing. Admin roles are managed via a dedicated collection.
 * @dataStructure
 *  - /technician_applications/{applicationId}: Stores technician applications (create access for all).
 *  - /technicians/{technicianId}: Stores approved technician profiles (read access for all, write access for admins).
 *  - /users/{userId}/jobs/{jobId}: Stores job details for each technician (owner-only access).
 *  - /roles_admin/{uid}: Defines admin roles (only admins can manage).
 * @keySecurityDecisions
 *  - Unauthenticated users can submit technician applications.
 *  - Only admins can manage technician profiles.
 *  - Users (technicians) have full control over their own job data.
 *  - Listing of user documents is restricted to the owner.
 *  - Implemented Authorization Independence by denormalizing data required for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create technician applications, but restricts all other operations.
     * @path /technician_applications/{applicationId}
     * @allow (create) User can create a new application.
     *  request.auth == null (unauthenticated)
     * @deny (get, list, update, delete) No one can read, list, update, or delete applications.
     *  All read and write operations are disallowed except for create.
     * @principle Allows unauthenticated users to submit applications; all other operations are denied.
     */
    match /technician_applications/{applicationId} {
      allow create: if true;
      allow get, list, update, delete: if false;
    }

    /**
     * @description Allows anyone to read approved technician profiles, but only admins can create, update, or delete them.
     * @path /technicians/{technicianId}
     * @allow (get, list) Any user can view the list of technicians and their profiles.
     *  request.auth != null (authenticated)
     * @allow (create, update, delete) Admins can create, update, and delete technician profiles.
     *  isAdmin() == true
     * @deny (create, update, delete) Non-admins cannot create, update, or delete technician profiles.
     *  isAdmin() == false
     * @principle Provides public read access to technician profiles, while restricting write access to admins only.
     */
    match /technicians/{technicianId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Allows a user to manage their own job data. Only the user who owns the data can create, read, update, or delete it.
     * @path /users/{userId}/jobs/{jobId}
     * @allow (create, get, list, update, delete) The user with ID {userId} can manage their own job entries.
     *  isOwner(userId) == true
     * @deny (create, get, list, update, delete) A user cannot manage job entries that do not belong to them.
     *  isOwner(userId) == false
     * @principle Enforces strict user-ownership for all job-related data.
     */
    match /users/{userId}/jobs/{jobId} {
      allow create, get, list, update, delete: if isOwner(userId);
    }

    /**
     * @description Allows admins to manage admin role assignments. Only users who are already admins can manage the /roles_admin collection.
     * @path /roles_admin/{uid}
     * @allow (create, get, list, update, delete) Only admins can manage the admin roles.
     *  isAdmin() == true
     * @deny (create, get, list, update, delete) Non-admins cannot manage the admin roles.
     *  isAdmin() == false
     * @principle Enforces strict admin-only access for managing admin roles.
     */
    match /roles_admin/{uid} {
      allow create, get, list, update, delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
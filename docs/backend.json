
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["customer", "technician", "admin"],
          "description": "The user's role in the system."
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "profileImageUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["id", "email", "role"]
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "description": "Represents a beauty or lifestyle service.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "string" },
        "imageId": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "type": "object",
      "description": "A blog post synced from Ghost CMS.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "heroImageUrl": { "type": "string", "format": "uri" },
        "excerpt": { "type": "string" },
        "metaDescription": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "format": "uri" }
      },
      "required": ["title", "slug", "content", "publishedAt"]
    },
    "WebhookLog": {
      "title": "Webhook Log",
      "type": "object",
      "description": "Logs of incoming webhook activity for health monitoring.",
      "properties": {
        "source": { "type": "string" },
        "event": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "payloadSummary": { "type": "string" }
      },
      "required": ["source", "receivedAt", "status"]
    },
    "TechnicianApplication": {
      "title": "Professional Application",
      "type": "object",
      "description": "Represents a professional's application.",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "serviceArea": {
          "type": "string"
        },
        "socialMediaLink": {
          "type": "string",
          "format": "uri"
        },
        "licenseNumber": {
          "type": "string"
        },
        "applicationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        }
      },
      "required": ["firstName", "lastName", "email", "phone", "serviceArea", "licenseNumber", "applicationStatus"]
    },
    "Technician": {
      "title": "Professional",
      "type": "object",
      "description": "Represents an approved professional.",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "serviceArea": {
          "type": "string"
        },
        "socialMediaLink": {
          "type": "string",
          "format": "uri"
        },
        "licenseNumber": {
          "type": "string"
        },
        "applicationStatus": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "serviceRadius": {
          "type": "number"
        }
      },
      "required": ["id", "firstName", "lastName", "email", "phone", "serviceArea", "applicationStatus", "licenseNumber"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "type": "object",
      "description": "Represents a user who subscribed for news.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "collections": {
      "/users/{userId}": {
        "schema": {
          "$ref": "#/entities/UserProfile"
        },
        "description": "Stores public user profiles."
      },
      "/blogPosts/{slug}": {
        "schema": {
          "$ref": "#/entities/BlogPost"
        },
        "description": "Stores blog posts synced from Ghost CMS."
      },
      "/services/{serviceId}": {
        "schema": {
          "$ref": "#/entities/Service"
        },
        "description": "Stores the service menu."
      },
      "/webhook_logs/{logId}": {
        "schema": {
          "$ref": "#/entities/WebhookLog"
        },
        "description": "Logs of incoming webhook activity."
      },
      "/technician_applications/{applicationId}": {
        "schema": {
          "$ref": "#/entities/TechnicianApplication"
        },
        "description": "Stores submitted applications from potential professionals."
      },
      "/technicians/{technicianId}": {
        "schema": {
          "$ref": "#/entities/Technician"
        },
        "description": "Stores profiles of approved and active professionals."
      },
      "/subscribers/{subscriberId}": {
        "schema": {
          "$ref": "#/entities/Subscriber"
        },
        "description": "Stores email addresses of users who subscribed for news."
      }
    }
  }
}

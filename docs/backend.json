
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's profile information.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["customer", "technician", "admin"],
          "description": "The user's role in the system."
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "profileImageUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["id", "email", "role"]
    },
    "TechnicianApplication": {
      "title": "Professional Application",
      "type": "object",
      "description": "Represents a professional's application.",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "serviceArea": {
          "type": "string"
        },
        "socialMediaLink": {
          "type": "string",
          "format": "uri"
        },
        "licenseNumber": {
          "type": "string"
        },
        "applicationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        }
      },
      "required": ["firstName", "lastName", "email", "phone", "serviceArea", "licenseNumber", "applicationStatus"]
    },
    "Technician": {
      "title": "Professional",
      "type": "object",
      "description": "Represents an approved professional.",
      "properties": {
        "id": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "serviceArea": {
          "type": "string"
        },
        "socialMediaLink": {
          "type": "string",
          "format": "uri"
        },
        "licenseNumber": {
          "type": "string"
        },
        "applicationStatus": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "serviceRadius": {
          "type": "number"
        }
      },
      "required": ["id", "firstName", "lastName", "email", "phone", "serviceArea", "applicationStatus", "licenseNumber"]
    },
    "ProductInquiry": {
      "title": "Product Restock Inquiry",
      "type": "object",
      "description": "Represents a customer restock notification request and price willingness data.",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "quantity": { "type": "string" },
        "priceWillingness": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "productName", "email", "submittedAt"]
    },
    "PressInquiry": {
      "title": "Press Inquiry",
      "type": "object",
      "description": "Represents a press inquiry submission.",
      "properties": {
        "name": {
          "type": "string"
        },
        "publication": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "message": {
          "type": "string"
        },
        "submittedAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": ["name", "publication", "email", "message", "submittedAt"]
    },
    "PartnershipInquiry": {
      "title": "Partnership Inquiry",
      "type": "object",
      "description": "Represents a partnership inquiry submission.",
      "properties": {
        "companyName": {
          "type": "string"
        },
        "contactName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "message": {
          "type": "string"
        },
        "submittedAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": ["companyName", "contactName", "email", "message", "submittedAt"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "type": "object",
      "description": "Represents a user who subscribed for news.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "collections": {
      "/users/{userId}": {
        "schema": {
          "$ref": "#/entities/UserProfile"
        },
        "description": "Stores public user profiles."
      },
      "/technician_applications/{applicationId}": {
        "schema": {
          "$ref": "#/entities/TechnicianApplication"
        },
        "description": "Stores submitted applications from potential professionals."
      },
      "/technicians/{technicianId}": {
        "schema": {
          "$ref": "#/entities/Technician"
        },
        "description": "Stores profiles of approved and active professionals."
      },
       "/press_inquiries/{inquiryId}": {
        "schema": {
          "$ref": "#/entities/PressInquiry"
        },
        "description": "Stores submitted press inquiries."
      },
      "/partnership_inquiries/{inquiryId}": {
        "schema": {
            "$ref": "#/entities/PartnershipInquiry"
        },
        "description": "Stores submitted partnership inquiries."
      },
      "/product_inquiries/{inquiryId}": {
        "schema": {
            "$ref": "#/entities/ProductInquiry"
        },
        "description": "Stores customer restock and pricing inquiries."
      },
      "/subscribers/{subscriberId}": {
        "schema": {
          "$ref": "#/entities/Subscriber"
        },
        "description": "Stores email addresses of users who subscribed for news."
      }
    }
  }
}
